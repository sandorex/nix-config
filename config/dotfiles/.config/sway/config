include /etc/sway/config-vars.d/*
include /etc/sway/config.d/*

set $basedir ~/.config/sway
set $scripts $basedir/scripts

# include the host specific variables
include sway/$(echo $HOSTNAME)/vars

input type:keyboard {
    xkb_layout us
    xkb_options caps:escape

    repeat_delay 400
    repeat_rate 25
}

# use solid color by default (specific hosts can override it later on)
output * bg #181A27 solid_color

# i do not like it
primary_selection disabled

# TODO should this be enabled?
seat * hide_cursor 8000

# remove title but leave border on focused window
default_border pixel
default_floating_border normal

# only show borders between windows
hide_edge_borders both

# do not follow mouse
focus_follows_mouse no

# include keybindings
include sway/keybindings.conf

# include host specific config
include sway/$(echo $HOSTNAME)/config

# sway does not want to set XDG_CURRENT_DESKTOP
exec systemctl --user set-environment XDG_CURRENT_DESKTOP=sway XDG_SESSION_DESKTOP=sway
exec systemctl --user import-environment XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP

# open the eww bar and reload it
exec_always eww -c $basedir open bar && eww -c $basedir reload
