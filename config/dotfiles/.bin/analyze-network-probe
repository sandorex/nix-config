# TODO read from input or file
def main [
    --csv,
] {
    # TODO make latency a milliseconds unit
    # TODO gather should convert datetime into actual datetime
    let entries = gather | update datetime { into datetime }

    mut data = []
    mut output = []

    for i in 0..<($entries | length) {
        let entry = $entries | get $i

        if $entry.gateway > 500 or $entry.cloudflare > 500 or $entry.google > 500 {
            $data ++= [$entry]
        } else {
            if $data != [] {
                let start = ($data | first).datetime
                let end = ($data | last).datetime
                let maxima = $data | select gateway cloudflare google | math max
                $output ++= [
                    {
                        start: ($start | format date "%Y-%m-%d %H:%M:%S"),
                        end: ($end | format date "%Y-%m-%d %H:%M:%S"),
                        duration: (($end - $start) | into duration),
                        gateway_max: $maxima.gateway,
                        cloudflare_max: $maxima.cloudflare,
                        google_max: $maxima.google,
                    }
                ]

                # reset list
                $data = []
            }
        }
    }

    if $csv {
        $output
            # duration has to be in this format for librecalc to read
            | update duration { into int | into datetime | format date "%H:%M:%S" }
            | to csv
    } else {
        $output | table -e | print

        # print stats like interruption count and duration without network
        {
            interruptions: ($output | length),
            duration: ($output | select duration | math sum | get duration)
        } | table -e | print
    }
}
